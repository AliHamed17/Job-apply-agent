# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
.eggs/

# Virtual environments
.venv
venv/
env/

# Tests & coverage
.pytest_cache
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Secrets — never bake into image
.env
*.env
.claude/
.vercel/

# SQLite database files
*.db
*.sqlite3

# Private candidate materials and authenticated browser state
*.pdf
cvs/
user_profile.yaml
user_profile.yaml.*
cv_routing.yaml
cv_routing.yaml.*
employer_catalog.yaml
employer_catalog.yaml.*
employer_workflows.yaml
routing-evaluation-report.json
linkedin-smoke-qualification.json
fit_routing_qualification.json
.gmail_oauth.json
.gmail_oauth.json.*
.job-alerts/
.portal_profiles/
.linkedin_profile/
.browser-state/
runtime-data/
uploads/
.test-artifacts/
.job-agent/
automation-policy-ed25519.pem
bridge/.wwebjs_auth/
bridge/.wwebjs_cache/
bridge/session/

# Sanitized templates are required at image/runtime bootstrap. Re-include only
# these exact public examples after the private wildcard exclusions above.
!user_profile.yaml.example
!cv_routing.yaml.example
!employer_catalog.yaml.example
!fit_routing_qualification.json.example

# Logs
*.log
logs/

# Local dev artifacts
nginx/ssl/
monitoring/grafana/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
