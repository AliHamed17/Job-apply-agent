# ─── WhatsApp Cloud API ───────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_TOKEN=your-whatsapp-api-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret-for-signature-verification

# ─── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./job_agent.db

# ─── Redis (Celery broker) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM Provider ────────────────────────────────────
# Options: "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o

# ─── Application Modes ───────────────────────────────
APP_ENV=development
DRAFT_ONLY=true
AUTO_APPLY=false
DRY_RUN=true
# Required in production before any non-dry-run automation is allowed.
LIVE_AUTOMATION_ACKNOWLEDGED=false

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=10
POLITE_CRAWL_DELAY_SECONDS=2.0

# ─── Security ────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=
DEPENDENCY_HEARTBEAT_TTL_SECONDS=120

# ─── Allowed Senders (comma-separated phone numbers) ─
ALLOWED_SENDERS=

# ─── User Profile Path ──────────────────────────────
USER_PROFILE_PATH=user_profile.yaml
APPLICATION_DATA_DIR=.
MAX_RESUME_BYTES=10485760

# --- Full-auto policy ----
MIN_APPLY_SCORE=40.0
QUEUE_TTL_DAYS=7

# --- LinkedIn rate governor --
LINKEDIN_DAILY_CAP=45
LINKEDIN_MIN_GAP_S=120
LINKEDIN_MAX_GAP_S=360
ACTIVE_HOURS=09:00-21:00
LINKEDIN_BROWSER_PROFILE_DIR=.linkedin_profile

# --- Discovery ---
DISCOVERY_INTERVAL_H=3
DISCOVERY_PAGES_PER_QUERY=3

# --- WhatsApp outbound + email ---
WA_OUTBOUND_DAILY_CAP=15
WA_CONTACT_DEDUP_DAYS=30
# Where the host-run WhatsApp bridge listens. Bare-metal/host runs: localhost.
# docker-compose already overrides this to http://host.docker.internal:8100/send
# so the containerised API can reach a bridge on the host (see docker-compose.yml).
BRIDGE_SEND_URL=http://localhost:8100/send
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
