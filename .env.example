# ─── WhatsApp Cloud API ───────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_TOKEN=your-whatsapp-api-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret-for-signature-verification

# ─── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./job_agent.db

# ─── Redis (Celery broker) ────────────────────────────
REDIS_URL=redis://localhost:6379/0
# API, worker, and Beat must share Redis outside isolated unit tests.
TASKS_ALWAYS_EAGER=false

# ─── LLM Provider ────────────────────────────────────
# v4 application preparation uses one local model and has no cloud fallback.
LLM_PROVIDER=ollama
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=qwen2.5:7b
# Run `ollama serve` locally and `ollama pull qwen2.5:7b`. Private inference
# accepts only loopback or host.docker.internal and requires an exact local
# GGUF model digest reported by /api/tags.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NO_CLOUD=1
CLOUD_VISION_ENABLED=0
# Optional stricter runtime pin. When set it must equal the committed
# config/qualified_local_model.json digest; changing it requires requalification.
OLLAMA_EXPECTED_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_LEASE_WAIT_SECONDS=10
OLLAMA_LEASE_TTL_SECONDS=130
OLLAMA_NUM_CTX=16384
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
OLLAMA_CIRCUIT_RESET_SECONDS=30
LLM_MAX_PROMPT_CHARS=24000
LLM_GENERATION_MAX_HORIZON_SECONDS=120
LLM_CV_ROUTING=true

# ─── Application Modes ───────────────────────────────
APP_ENV=development
DRAFT_ONLY=true
AUTO_APPLY=false
DRY_RUN=true
# Required in production before any non-dry-run automation is allowed.
LIVE_AUTOMATION_ACKNOWLEDGED=false

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=10
POLITE_CRAWL_DELAY_SECONDS=2.0

# ─── Security ────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=
DEPENDENCY_HEARTBEAT_TTL_SECONDS=120

# ─── Allowed Senders (comma-separated phone numbers) ─
ALLOWED_SENDERS=
NOTIFICATION_RECIPIENT_EMAIL=
NOTIFICATION_RECIPIENT_PHONE=

# ─── User Profile Path ──────────────────────────────
USER_PROFILE_PATH=user_profile.yaml
APPLICATION_DATA_DIR=.
MAX_RESUME_BYTES=10485760

# --- Full-auto policy ----
MIN_APPLY_SCORE=40.0
QUEUE_TTL_DAYS=7

# --- LinkedIn rate governor --
LINKEDIN_DAILY_CAP=45
LINKEDIN_MIN_GAP_S=120
LINKEDIN_MAX_GAP_S=360
ACTIVE_HOURS=09:00-21:00
LINKEDIN_BROWSER_PROFILE_DIR=.linkedin_profile

# --- Employer portal browser sessions ---
# Sign in once with: python -m scripts.portal_session_bootstrap <job-url>
# Passwords are never read from Chrome/Edge and must never be stored here.
PORTAL_BROWSER_PROFILE_ROOT=.portal_profiles
PORTAL_BROWSER_HEADLESS=true
# Final Workday submit is additionally gated by an explicit application or
# batch approval. Keep false until the review workflow has been qualified.
PORTAL_FINAL_SUBMIT_ENABLED=false
PORTAL_REUSE_LAST_APPLICATION=true
EMPLOYER_WORKFLOW_PATH=employer_workflows.yaml

# --- Discovery ---
DISCOVERY_INTERVAL_H=3
DISCOVERY_PAGES_PER_QUERY=3
PUBLIC_DISCOVERY_ENABLED=true
# Remotive asks public API consumers to fetch no more than four times per day.
PUBLIC_DISCOVERY_INTERVAL_H=6
PUBLIC_DISCOVERY_MAX_JOBS=50
PUBLIC_DISCOVERY_TIMEOUT_S=20

# --- WhatsApp outbound + email ---
WA_OUTBOUND_DAILY_CAP=15
WA_CONTACT_DEDUP_DAYS=30
# Where the host-run WhatsApp bridge listens. Bare-metal/host runs: localhost.
# docker-compose already overrides this to http://host.docker.internal:8100/send
# so the containerised API can reach a bridge on the host (see docker-compose.yml).
BRIDGE_SEND_URL=http://localhost:8100/send
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
