# The repository root is not the application boundary. Deny the complete
# checkout, then admit only the isolated, redacted control-plane project and
# the root routing manifest that points at it.
/*
!vercel.json
!control_plane
control_plane/*
!control_plane/api
!control_plane/api/**
!control_plane/job_control_plane
!control_plane/job_control_plane/**
!control_plane/requirements.txt

# Defence in depth: these paths stay excluded even if a future allowlist rule
# is broadened. The public bundle must never contain candidate material,
# credentials, browser state, local databases, logs, or Vercel linkage.
control_plane/.env
control_plane/.env.*
control_plane/.git/
control_plane/.github/
control_plane/.vercel/
control_plane/**/.env
control_plane/**/.env.*
control_plane/**/__pycache__/
control_plane/**/.mypy_cache/
control_plane/**/.pytest_cache/
control_plane/**/.ruff_cache/
control_plane/**/.venv/
control_plane/**/*.db
control_plane/**/*.sqlite
control_plane/**/*.sqlite3
control_plane/**/*.log
control_plane/**/*.pdf
control_plane/**/*.doc
control_plane/**/*.docx
control_plane/**/*.rtf
control_plane/**/*.pem
control_plane/**/*.p12
control_plane/**/*.pfx
control_plane/**/*.key
control_plane/**/cvs/
control_plane/**/profile-data/
control_plane/**/profiles/
control_plane/**/runtime-data/
control_plane/**/uploads/
control_plane/**/sessions/
control_plane/**/session-data/
control_plane/**/browser-data/
control_plane/**/browser-state/
control_plane/**/device-state/
control_plane/**/.keys/
control_plane/**/.linkedin_profile/
control_plane/**/.portal_profiles/
control_plane/**/user_profile*
control_plane/**/cv_routing*
control_plane/**/resume*
control_plane/**/*credential*
control_plane/**/*private*
control_plane/**/*secret*
control_plane/**/*token*
