# Copy this file to user_profile.yaml and keep the personal copy outside Git.
personal:
  name: Your Name
  email: you@example.com
  phone: "+10000000000"
  location: City, Country

links:
  linkedin: https://www.linkedin.com/in/your-profile
  github: https://github.com/your-account
  portfolio: https://example.com

resume:
  text: ""
  pdf_path: ""

cover_letter:
  style: professional, personable, and concise

preferences:
  roles:
    - Software Engineer
  locations:
    - Your preferred location
  remote_ok: true
  hybrid_ok: true
  onsite_ok: true
  salary:
    min: 0
    max: 0
    currency: USD
  keywords:
    - Python
  blacklist_companies: []
  seniority:
    - mid

attachments: []

evidence:
  # Populated by CV extraction. These facts may support matching/materials but
  # never count as operator confirmation for legal or demographic answers.
  cv_extracted: {}
  # Add sensitive facts only after checking them yourself. They are consumed
  # by deterministic form policy and are NEVER sent to an LLM.
  #
  # Write these through PUT /api/profile/onboarding, not by editing this file:
  # load_versioned_profile_snapshot reads the UserProfileVersion table and only
  # falls back to YAML when that table is empty, returning version=None, which
  # cannot receive a final-submit permit.
  #
  # An empty or absent fact ABSTAINS: the form field is left for review rather
  # than answered. That is the safe outcome — never guess a legal answer.
  user_confirmed:
    # Legal authorisation, per jurisdiction. The unsuffixed key below is the
    # jurisdiction-*unspecified* answer and satisfies no question that names a
    # country; a question asking specifically about the United States resolves
    # only from work_authorization_us.
    work_authorization: ""
    work_authorization_il: ""
    work_authorization_us: ""
    work_authorization_eu: ""
    visa_sponsorship: ""
    visa_sponsorship_il: ""
    visa_sponsorship_us: ""
    visa_sponsorship_eu: ""
    citizenship: ""
    nationality: ""
    security_clearance: ""
    # Recurring facts nearly every ATS application asks for.
    notice_period: ""
    salary_expectation: ""
    salary_currency: ""
    availability_date: ""
    # Both shapes are derived server-side from one input: free-text fields want
    # "2 years", NUMBER controls want "2".
    years_experience: ""
    years_experience_number: ""
    languages: ""
    relocation: ""
    work_mode: ""
    highest_degree: ""
    how_did_you_hear: ""
    # "decline" or "disclose". Declining is a valid, complete answer.
    demographic_disclosure: ""
    gender: ""
  inferred_preferences: {}
